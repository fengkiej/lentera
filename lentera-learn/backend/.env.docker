# Server Configuration
PORT=3001
NODE_ENV=production

# Database
DATABASE_URL=./database/lentera.db

# JWT Configuration
JWT_SECRET=jwt_secret_for_docker_environment
JWT_REFRESH_SECRET=jwt_refresh_secret_for_docker_environment
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# API Configuration
API_PREFIX=/api/v1

# Clerk Configuration (replace with actual keys in production)
CLERK_PUBLISHABLE_KEY=pk_test_bmF0dXJhbC1oYXdrLTMuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_clerk_key_for_docker

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
